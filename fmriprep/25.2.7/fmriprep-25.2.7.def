Bootstrap: docker
From: nipreps/fmriprep:25.2.7

%post
    # eMudhra mitigation
    sed -i \
        -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' \
        -e 's|^mozilla/Comodo_AAA_Services_root.crt|!&|' \
        /etc/ca-certificates.conf && update-ca-certificates

    rm -rf /app/.pixi/envs/fmriprep/lib/python3.12/site-packages/certifi*

%runscript
    /app/.pixi/envs/fmriprep/bin/fmriprep "$@"

%labels
    Maintainer rs7wz@virginia.edu
